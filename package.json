{
  "name": "research-casino",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @rc/api prisma:migrate",
    "db:seed": "pnpm --filter @rc/api prisma:seed",
    "db:studio": "pnpm --filter @rc/api prisma:studio"
  },
  "devDependencies": { "turbo": "^2.0.0", "typescript": "^5.4.0" }
}
