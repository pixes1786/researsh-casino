# ══════════════════════════════════════════════════════════════
# Production config for Render + Supabase + Upstash + Vercel
# ══════════════════════════════════════════════════════════════

# ─── Database (Supabase) ───
# Transaction pooler (runtime)
DATABASE_URL="postgresql://postgres.gkbykzsdydnmmztidftn:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (migrations)
DIRECT_URL="postgresql://postgres.gkbykzsdydnmmztidftn:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ─── Redis (Upstash) ───
# Скопируй из Upstash Console → ваш DB → Connect → ioredis
REDIS_URL="rediss://default:[UPSTASH-PASSWORD]@[UPSTASH-HOST]:6379"

# ─── Auth ───
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
NODE_ENV=production
WEB_ORIGIN=https://your-app.vercel.app

# ─── URLs для фронта ───
NEXT_PUBLIC_API_URL=https://your-app.onrender.com
NEXT_PUBLIC_WS_URL=https://your-app.onrender.com

# ─── Captcha (optional, после настройки Turnstile) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Admin Basic Auth (только для локального Caddy; на Render не используется) ───
ADMIN_USER=oleg
ADMIN_PASS_HASH=
