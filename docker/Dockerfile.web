FROM node:20-alpine
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json turbo.json ./
COPY apps/web/package.json apps/web/
COPY packages ./packages
RUN pnpm install --no-frozen-lockfile
COPY . .
RUN pnpm --filter @rc/web build
EXPOSE 3000
CMD ["pnpm", "--filter", "@rc/web", "start"]
